{
  "name": "ti-corporation-backend",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node dist/main",
    "start:dev": "node ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "build": "npm run prisma:generate && node ./node_modules/@nestjs/cli/bin/nest.js build",
    "start:prod": "node dist/main",
    "test": "jest --runInBand",
    "test:smoke": "node --experimental-strip-types --test tests-policy.test.mjs",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.0",
    "@nestjs/core": "^10.2.0",
    "@nestjs/platform-express": "^10.2.0",
    "@prisma/client": "^5.20.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.12.0",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.12"
  }
}
