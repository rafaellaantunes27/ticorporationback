{
  "version": 2,
  "functions": { "api/index.js": { "maxDuration": 10 } },
  "rewrites": [ {"source": "/api/:path*", "destination": "/api/index.js"} ],
  "headers": [{ "source": "/api/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Cache-Control", "value": "no-store" }
  ] }]
}
